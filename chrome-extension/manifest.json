{
  "manifest_version": 3,
  "name": "SmartStudy Agent",
  "version": "0.2.0",
  "description": "Adaptive AI tutor with a closed-loop reasoning cycle — turns any page, PDF, or YouTube video into a personalized quiz.",
  "action": {
    "default_title": "SmartStudy Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://router.huggingface.co/*",
    "https://www.youtube.com/*",
    "https://*.youtube.com/*",
    "<all_urls>"
  ],
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/pdfjs/pdf.mjs",
        "lib/pdfjs/pdf.worker.mjs"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
